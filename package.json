    "three": "^0.186.1",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.17",
    "tsx": "^4.23.15",
    "xatlas-web": "^0.1.0",
    "zustand": "^5.0.16"
