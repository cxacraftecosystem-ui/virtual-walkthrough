# Copy to .env.local (Next.js loads it; `npm run db:migrate` too). Never commit real values.
# Everything is optional for local development: without DATABASE_URL the app uses SQLite in
# .data/museum.sqlite, without S3_BUCKET uploads go to .data/media and are served at /media/*.

# ---------------------------------------------------------------- admin account + roles
# Created on first start; when BOTH are set the password is re-synced on every cold start.
# Dev default (only outside production): admin@museum.local / admin12345
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Master admins (the only ones who can edit the ACCESS LIST), comma-separated. Falls back to
# MASTER_ADMIN_EMAIL (single address), then ADMIN_EMAIL. Masters get their rights by signing in
# with Google (verified address) — or with ADMIN_PASSWORD when the address is ADMIN_EMAIL.
# Roles: visitor < curator (content + media) < admin (+ comments, analytics, users) < master.
# Curators/admins are granted in the admin's Access page (emails or whole @domains) and apply
# once the person signs in with Google (verified address).
MASTER_ADMIN_EMAILS=

# ---------------------------------------------------------------- Google sign-in (optional)
# Google Cloud Console → APIs & Services → Credentials → Create credentials → OAuth client ID →
# "Web application"; Authorised JavaScript origins: http://localhost:3000 and your production
# origin (e.g. https://your-app.vercel.app). Empty → the "Sign in with Google" button is hidden.
GOOGLE_CLIENT_ID=
# Not used by the ID-token (GIS) flow; kept server-side for a possible authorization-code flow.
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- database (Supabase Postgres)
# Supabase → Project → Connect → "Transaction pooler" URI (port 6543), e.g.
# postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# require (default for remote hosts) | verify-full | disable
DATABASE_SSL=
# pool size per server instance (default 5, or 2 on Vercel)
DATABASE_POOL_MAX=
# SQLite fallback file (only used when DATABASE_URL is empty)
DB_PATH=.data/museum.sqlite
# Migrations only (npm run db:migrate / CI): session pooler (port 5432) or direct connection
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------- media storage (AWS S3 / compatible)
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public URL prefix for objects (CloudFront / custom domain). Default: https://<bucket>.s3.<region>.amazonaws.com
# Production uses the CloudFront distribution from infra/setup-cloudfront.sh (see infra/cloudfront.md)
S3_PUBLIC_BASE_URL=
# S3-compatible endpoint, e.g. Supabase Storage: https://<project-ref>.supabase.co/storage/v1/s3
# (then S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>)
S3_ENDPOINT=
# Optional key prefix inside the bucket, e.g. museum/
S3_PREFIX=
# Local-disk fallback directory (only used when S3_BUCKET is empty)
MEDIA_DIR=.data/media

# ---------------------------------------------------------------- local dev against production
# Keep production credentials under REMOTE_<NAME> (DATABASE_URL, DIRECT_DATABASE_URL, S3_BUCKET,
# S3_PUBLIC_BASE_URL, ADMIN_EMAIL, ADMIN_PASSWORD, MASTER_ADMIN_EMAILS); they are only used when
# USE_REMOTE=1, so a plain `npm run dev` keeps using SQLite + local disk.
#   USE_REMOTE=1 npm run db:migrate
USE_REMOTE=0

# ---------------------------------------------------------------- misc
# Force the Secure cookie flag on/off (default: on when NODE_ENV=production)
COOKIE_SECURE=
# Extra origins allowed to call state-changing API routes (comma-separated). Same-origin always allowed.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------- error monitoring (docs/API.md → Errors / monitoring)
# Fraction (0–1) of client error reports sent by browsers to POST /api/errors (default 1)
NEXT_PUBLIC_ERROR_SAMPLE_RATE=
# Server-side sampling guard for stored reports (default 1)
ERROR_SAMPLE_RATE=
# Optional: also forward client errors to Sentry via its envelope HTTP API (no SDK), e.g. https://<key>@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------- live tours & presence (optional)
# Supabase Realtime (broadcast + presence; no tables needed). Public values — they are inlined in
# the client bundle. Get them with `supabase projects api-keys --project-ref <ref>` (use the
# publishable key, or the legacy anon key). Empty → presence / live tours hide themselves.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: channel/exhibition id (default hand-block-printing)
NEXT_PUBLIC_LIVE_ROOM=
# Server-only HMAC secret (≥ 32 chars) for docent tokens (POST /api/live/token, GET /api/live/verify).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LIVE_TOKEN_SECRET=
