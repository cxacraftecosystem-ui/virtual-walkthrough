# Copy to .env.local (Next.js loads it; `npm run db:migrate` too). Never commit real values.
# Everything is optional for local development: without DATABASE_URL the app uses SQLite in
# .data/museum.sqlite, without S3_BUCKET uploads go to .data/media and are served at /media/*.

# ---------------------------------------------------------------- admin account
# Created on first start; when BOTH are set the password is re-synced on every cold start.
# Dev default (only outside production): admin@museum.local / admin12345
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------- database (Supabase Postgres)
# Supabase → Project → Connect → "Transaction pooler" URI (port 6543), e.g.
# postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# require (default for remote hosts) | verify-full | disable
DATABASE_SSL=
# pool size per server instance (default 5, or 2 on Vercel)
DATABASE_POOL_MAX=
# SQLite fallback file (only used when DATABASE_URL is empty)
DB_PATH=.data/museum.sqlite

# ---------------------------------------------------------------- media storage (AWS S3 / compatible)
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public URL prefix for objects (CloudFront / custom domain). Default: https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_BASE_URL=
# S3-compatible endpoint, e.g. Supabase Storage: https://<project-ref>.supabase.co/storage/v1/s3
# (then S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>)
S3_ENDPOINT=
# Optional key prefix inside the bucket, e.g. museum/
S3_PREFIX=
# Local-disk fallback directory (only used when S3_BUCKET is empty)
MEDIA_DIR=.data/media

# ---------------------------------------------------------------- misc
# Force the Secure cookie flag on/off (default: on when NODE_ENV=production)
COOKIE_SECURE=
# Extra origins allowed to call state-changing API routes (comma-separated). Same-origin always allowed.
ALLOWED_ORIGINS=
